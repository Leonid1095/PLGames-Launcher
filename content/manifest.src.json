      "id": "northlight",
      "name": "Новый свет Northlight: тени от солнца, отражённый свет, объёмный туман",
      "group": "Forever",
      "type": "installer",
      "version": "0.3.183-plg1",
      "conflicts": [
        "reshade",
        "dxvk"
      ],
      "requires": "vulkan13",
      "fallback": "reshade",
      "archive": {
        "src": "../dist-forever/installers/northlight-0.3.183-plg1.zip"
      },
      "install": [
        "runtime/python.exe",
        "-I",
        "-B",
        "-X",
        "utf8",
        "app/renderer/northlight_install.py",
        "--default-action",
        "install",
        "--client",
        "{client}",
        "--locale",
        "{locale}",
        "--no-art-layer",
        "--yes"
      ],
      "uninstall": [
        "runtime/python.exe",
        "-I",
        "-B",
        "-X",
        "utf8",
        "app/renderer/northlight_install.py",
        "--default-action",
        "uninstall",
        "--client",
        "{client}",
        "--yes"
      ],
      "progress": "^\\s*(?P<label>[A-Za-z0-9]+): (?P<pct>\\d+)%",
      "marker": "northlight-renderer.ini"
    },
